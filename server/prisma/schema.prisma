generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             Int      @id @default(autoincrement())
  name           String
  logo           String?
  industry       String?
  contactNumber  String?
  description    String?
  streetAddress  String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  isoStandards   String[] @default([])
  location       String?
  contactDetails String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         Int?
  user           User?    @relation("UserCompanies", fields: [userId], references: [id])
  sites          Site[]
  @@index([userId])
}

model Site {
  id              Int            @id @default(autoincrement())
  name            String
  description     String?
  siteType        String?
  status          String?        @default("Active")
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  contactName     String?
  contactPosition String?
  contactNumber   String?
  email           String?
  companyId       Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          Int?
  auditPrograms   AuditProgram[]
  departments     Department[]
  company         Company        @relation(fields: [companyId], references: [id])
  user            User?          @relation("UserSites", fields: [userId], references: [id])
  @@index([userId])
  @@index([companyId])
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  siteId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  code        String?
  manager     String?
  status      String?  @default("Active")
  site        Site     @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

model User {
  id                Int            @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String         @unique
  mobile            String?
  role              String
  customRoleName    String?
  password          String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isActive          Boolean        @default(true)
  /// Set when the user proves they control their email (signup OTP or org invite OTP).
  emailVerifiedAt   DateTime?
  creatorId         Int?

  // Subscription and Trial fields
  trialStartDate    DateTime?
  trialEndDate      DateTime?
  subscriptionStatus String?
  subscriptionPlan   String?
  planStartDate      DateTime?
  planExpiryDate     DateTime?
  nextBillingDate    DateTime?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  stripePriceId      String?
  stripeInvoiceId    String?
  stripePaymentIntentId String?

  // Renewal preferences
  renewalType       String?    // 'AUTOPAY' or 'MANUAL'
  autopayConsent    Boolean?   @default(false)

  // Team/Audit relations
  leadAuditPlans    AuditPlan[]    @relation("PlanLeadAuditor")
  createdPlans      AuditPlan[]    @relation("UserAuditPlans")
  leadAuditPrograms AuditProgram[] @relation("LeadAuditor")
  createdPrograms   AuditProgram[] @relation("UserAuditPrograms")
  onboardingCompleted Boolean    @default(false)
  /// Wrong-password streak; cleared on successful login or password reset. At LOGIN_MAX_FAILED_ATTEMPTS, login is blocked until reset.
  failedLoginAttempts Int          @default(0)
  /// Set once on the user's first successful login.
  firstLoginAt        DateTime?
  /// Updated on each successful login (new session issued).
  lastLoginAt         DateTime?
  companies         Company[]      @relation("UserCompanies")
  sites             Site[]         @relation("UserSites")
  creator           User?          @relation("UserCreator", fields: [creatorId], references: [id])
  createdUsers      User[]         @relation("UserCreator")
  auditPrograms     AuditProgram[] @relation("AuditorPrograms")
  auditPlans        AuditPlan[]    @relation("PlanAuditors")

  // Nonconformance relations
  assignedNonconformances  Nonconformance[] @relation("NcAssignee")
  reviewedNonconformances  Nonconformance[] @relation("NcReviewer")
  createdNonconformances   Nonconformance[] @relation("NcCreatedBy")
  nonconformanceResponses  NonconformanceResponse[] @relation("NcResponseSubmittedBy")
  nonconformanceReviews    NonconformanceReview[] @relation("NcReviewDecidedBy")
  nonconformanceActivities NonconformanceActivity[] @relation("NcActivityActor")
  notifications            Notification[] @relation("NotificationRecipient")

  // Payment relations
  subscriptions     Subscription[]
  payments          Payment[]
  sessions          Session[]
  orgGapAnalysisStore        OrgGapAnalysisStore?        @relation("OrgGapStore")
  orgSelfAssessmentStore     OrgSelfAssessmentStore?     @relation("OrgSelfAssessmentStore")
  userGapAnalysisStore       UserGapAnalysisStore?
  userSelfAssessmentStore    UserSelfAssessmentStore?

  @@index([creatorId])
  @@index([role])
  @@index([createdAt])
  @@index([isActive, createdAt])
}

/// Organization-wide gap analysis history and in-progress draft (shared by all org members).
/// @deprecated Gap analyses are per-user (UserGapAnalysisStore); org store is legacy only.
model OrgGapAnalysisStore {
  orgRootUserId     Int      @id
  analyses          Json     @default("[]")
  draft             Json?
  updatedAt         DateTime @updatedAt
  updatedByUserId   Int?
  orgRoot           User     @relation("OrgGapStore", fields: [orgRootUserId], references: [id], onDelete: Cascade)
}

/// Per-user gap analysis history and in-progress draft (private to each user).
model UserGapAnalysisStore {
  userId      Int      @id
  analyses    Json     @default("[]")
  draft       Json?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Organization-wide self assessment history and in-progress draft.
/// @deprecated Self assessments are per-user (UserSelfAssessmentStore); org store is legacy only.
model OrgSelfAssessmentStore {
  orgRootUserId     Int      @id
  assessments       Json     @default("[]")
  draft             Json?
  updatedAt         DateTime @updatedAt
  updatedByUserId   Int?
  orgRoot           User     @relation("OrgSelfAssessmentStore", fields: [orgRootUserId], references: [id], onDelete: Cascade)
}

/// Per-user self assessment history and in-progress draft (private to each user).
model UserSelfAssessmentStore {
  userId        Int      @id
  assessments   Json     @default("[]")
  draft         Json?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Server-side session (opaque bearer token). Replaces stateless JWT for request authentication.
model Session {
  token     String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int
  stripeSubscriptionId String    @unique
  plan                 String
  status               String    // active, past_due, canceled, unpaid
  cancelAtPeriodEnd    Boolean   @default(false)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripePriceId        String
  sub_renewal_date     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])
}

model Payment {
  id                   Int       @id @default(autoincrement())
  userId               Int
  amount               Float
  currency             String
  status               String
  stripePaymentIntentId String?  @unique
  stripeInvoiceId      String?   @unique
  stripeSessionId      String?   @unique
  billingType          String    // monthly, yearly, contract
  duration             String?   // 1year, 3years, 6years
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id               String   @id // Stripe Event ID
  type             String
  processed        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model AuditProgram {
  id            Int         @id @default(autoincrement())
  name          String
  isoStandard   String
  frequency     String
  duration      Int         @default(3)
  siteId        Int
  scheduleData  Json?
  status        String      @default("Draft")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  leadAuditorId Int?
  userId        Int?
  auditPlans    AuditPlan[]
  leadAuditor   User?       @relation("LeadAuditor", fields: [leadAuditorId], references: [id])
  site          Site        @relation(fields: [siteId], references: [id])
  user          User?       @relation("UserAuditPrograms", fields: [userId], references: [id])
  auditors      User[]      @relation("AuditorPrograms")
  @@index([userId])
  @@index([siteId])
  @@index([leadAuditorId])
  @@index([createdAt])
  @@index([status])
}

model AuditPlan {
  id             Int          @id @default(autoincrement())
  auditProgramId Int
  executionId    String
  auditType      String?
  date           DateTime?
  location       String?
  scope          String?
  objective      String?
  criteria       String?
  leadAuditorId  Int?
  itinerary      Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditName      String?
  templateId     String?
  auditData      Json?
  userId         Int?
  findingsData   Json?
  auditProgram   AuditProgram @relation(fields: [auditProgramId], references: [id])
  leadAuditor    User?        @relation("PlanLeadAuditor", fields: [leadAuditorId], references: [id])
  user           User?        @relation("UserAuditPlans", fields: [userId], references: [id])
  auditors       User[]       @relation("PlanAuditors")
  nonconformances Nonconformance[]

  @@unique([auditProgramId, executionId])
  @@index([userId])
  @@index([auditProgramId])
  @@index([leadAuditorId])
  @@index([createdAt])
}

/// Formal nonconformance raised from a Minor/Major audit finding (finding lives in AuditPlan JSON).
model Nonconformance {
  id                 Int       @id @default(autoincrement())
  ncNumber           String    @unique
  auditPlanId        Int
  /// Client finding id from auditData (e.g. clause-{planId}-{clauseId}).
  findingId          String
  findingTitle       String
  findingDescription String
  /// Minor | Major
  severity           String
  assigneeId         Int
  reviewerId         Int
  dueDate            DateTime?
  /// ASSIGNED | RESPONSE_SUBMITTED | CHANGES_REQUESTED | CLOSED
  status             String    @default("ASSIGNED")
  closedAt           DateTime?
  createdById        Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditPlan          AuditPlan @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  assignee           User      @relation("NcAssignee", fields: [assigneeId], references: [id])
  reviewer           User      @relation("NcReviewer", fields: [reviewerId], references: [id])
  createdBy          User      @relation("NcCreatedBy", fields: [createdById], references: [id])
  responses          NonconformanceResponse[]
  reviews            NonconformanceReview[]
  activities         NonconformanceActivity[]
  notifications      Notification[]

  @@unique([auditPlanId, findingId])
  @@index([auditPlanId])
  @@index([assigneeId])
  @@index([reviewerId])
  @@index([status])
  @@index([createdById])
}

/// Append-only auditee response against a Nonconformance.
model NonconformanceResponse {
  id                      Int       @id @default(autoincrement())
  nonconformanceId        Int
  version                 Int
  rootCause               String
  immediateCorrection     String?
  correctiveAction        String
  preventiveAction        String?
  proposedCompletionDate  DateTime?
  additionalComments      String?
  /// Filenames only (JSON string array).
  evidenceFilenames       Json      @default("[]")
  submittedById           Int
  submittedAt             DateTime  @default(now())

  nonconformance          Nonconformance @relation(fields: [nonconformanceId], references: [id], onDelete: Cascade)
  submittedBy             User           @relation("NcResponseSubmittedBy", fields: [submittedById], references: [id])

  @@unique([nonconformanceId, version])
  @@index([nonconformanceId])
  @@index([submittedById])
  @@index([submittedAt])
}

/// Append-only auditor/reviewer decision against a Nonconformance.
model NonconformanceReview {
  id               Int       @id @default(autoincrement())
  nonconformanceId Int
  /// APPROVE | REQUEST_CHANGES
  decision         String
  comment          String?
  reviewedById     Int
  reviewedAt       DateTime  @default(now())

  nonconformance   Nonconformance @relation(fields: [nonconformanceId], references: [id], onDelete: Cascade)
  reviewedBy       User           @relation("NcReviewDecidedBy", fields: [reviewedById], references: [id])

  @@index([nonconformanceId])
  @@index([reviewedById])
  @@index([reviewedAt])
}

/// Append-only activity timeline for a Nonconformance.
model NonconformanceActivity {
  id               Int       @id @default(autoincrement())
  nonconformanceId Int
  /// RAISED | RESPONSE_SUBMITTED | CHANGES_REQUESTED | APPROVED | CLOSED
  type             String
  message          String
  comment          String?
  actorId          Int?
  createdAt        DateTime  @default(now())

  nonconformance   Nonconformance @relation(fields: [nonconformanceId], references: [id], onDelete: Cascade)
  actor            User?          @relation("NcActivityActor", fields: [actorId], references: [id])

  @@index([nonconformanceId])
  @@index([actorId])
  @@index([createdAt])
}

/// In-app notification for Nonconformance / finding assignment events.
model Notification {
  id                 Int       @id @default(autoincrement())
  recipientUserId    Int
  /// Optional — finding assignments may notify without a formal NC record.
  nonconformanceId   Int?
  /// Optional deep link (e.g. /audit-findings/12/checklist-1-2).
  linkPath           String?
  /// NC_ASSIGNED | NC_RESPONSE_SUBMITTED | NC_CHANGES_REQUESTED | NC_CLOSED | FINDING_ASSIGNED | FINDING_RESPONSE_SUBMITTED
  type               String
  title              String
  message            String
  isRead             Boolean   @default(false)
  createdAt          DateTime  @default(now())

  recipient          User            @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  nonconformance     Nonconformance? @relation(fields: [nonconformanceId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, isRead])
  @@index([nonconformanceId])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
